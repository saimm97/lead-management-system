# Replace CHANGE_ME with the Postgres password (must match the database you run).
DATABASE_URL=postgresql+asyncpg://leadpro:CHANGE_ME@localhost:5433/leadpro
REDIS_URL=redis://localhost:6379/0
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=reports@yourcompany.com
# CV Optimizer LLM (any OpenAI-compatible endpoint). Set the API key to enable.
# Examples:
#   Google Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.5-flash
#   OpenRouter:                LLM_BASE_URL=https://openrouter.ai/api/v1                              LLM_MODEL=z-ai/glm-5.2
#                              (leave LLM_MODEL empty to use your OpenRouter account default model)
#   Zhipu GLM:                 LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4                     LLM_MODEL=glm-4.5
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# AI Pipeline daily job feed. Public example: https://remotive.com/api/remote-jobs
JOB_FEED_URL=
# Comma-separated Greenhouse board tokens (boards-api.greenhouse.io).
GREENHOUSE_BOARDS=stripe,gitlab,airbnb,cloudflare,figma,discord,databricks,robinhood
# Embedding model on the same LLM_BASE_URL. Leave blank to sort the pipeline by date.
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIM=1536
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS — comma-separated allowed origins (add your deployed frontend URL)
CORS_ORIGINS=http://localhost:3000
# Optional regex to allow dynamic origins (e.g. Vercel preview deployments):
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@leadpro.com
# Password for the first admin account. Set your own before the first run.
ADMIN_PASSWORD=CHANGE_ME_admin_password
ADMIN_NAME=System Admin

# Google Calendar integration (leave blank to disable)
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console,
# enable the Google Calendar API, and register the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback
